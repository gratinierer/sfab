# The tool versions CI (.github/workflows/ci.yml) and the deploy build (buildspec.yml) install,
# kept in one place. Plain KEY=value lines: CI appends them to $GITHUB_ENV, which takes quotes
# literally, and the build sources the file. Rust comes from lambda/rust-toolchain.toml.
UV_VERSION=0.13.6
CARGO_LAMBDA_VERSION=1.9.2
# The devcontainer's zig on 2026-11-04; it comes from apt there, unpinned.
ZIGLANG_VERSION=0.16.0
CARGO_AUDIT_VERSION=0.22.2
# The devcontainer's CDK CLI on 2026-11-09; nothing pinned it before.
CDK_CLI_VERSION=2.1146.1
