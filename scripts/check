#!/usr/bin/env bash
# Every check, in this order: scripts/build (generate, the API definition's tests, build the
# Lambdas), then audit and test. It runs before each commit and in CI; the deploy runs only
# scripts/build. See .stories/2-identity-api/spec.md "Delivery" and
# .stories/19-deploy-build-cache/spec.md Goal 2.
# Stops at the first failure.
#   scripts/check [--require-secret]
# --require-secret goes to scripts/build: the generate step then never falls back to the
# committed fixture (see scripts/build).
set -euo pipefail
cd "$(dirname "$0")/.."

require_secret=()
case "${1:-}" in
  "") ;;
  --require-secret) require_secret=(--require-secret) ;;
  *) echo "check: unknown argument $1; takes only --require-secret" >&2; exit 2 ;;
esac

step() { printf '\n==> %s\n' "$*"; }

scripts/build "${require_secret[@]}"

step "Audit dependencies"
scripts/audit

step "Test"
(cd lambda && cargo test --workspace --locked)
# Tests always use the committed fixture, never the owner's real config.
(cd cdk && SFAB_CONFIG=tests/fixtures/sfab.config.test.toml .venv/bin/python -m pytest -q)
