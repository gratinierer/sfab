#!/usr/bin/env bash
# The steps CI and the deploy script both run, in this order:
# generate, build, audit, test. See .stories/2-identity-api/spec.md "Delivery".
# Stops at the first failure.
set -euo pipefail
cd "$(dirname "$0")/.."

# With no config at all, as in an agent's container, check against the committed fixture, as CI
# does. A deploy can't use it: cdk/app.py reads sfab.config.toml and stops when it's missing.
if [ -z "${SFAB_CONFIG:-}" ] && [ ! -f sfab.config.toml ]; then
  export SFAB_CONFIG=cdk/tests/fixtures/sfab.config.test.toml
  echo "check: no sfab.config.toml, so using $SFAB_CONFIG" >&2
fi

step() { printf '\n==> %s\n' "$*"; }

step "Python environment (cdk/.venv)"
[ -d cdk/.venv ] || (cd cdk && uv venv -q .venv)
uv pip sync -q --python cdk/.venv/bin/python --require-hashes cdk/requirements.txt

step "Generate"
# The public API description and the website pages, from the active config (SFAB_CONFIG or
# sfab.config.toml), so a deploy publishes the real abuse_contact and API host.
cdk/.venv/bin/python cdk/generate_public_openapi.py
cdk/.venv/bin/python cdk/generate_website.py

step "Build the Lambdas (arm64)"
(cd lambda && cargo lambda build --release --arm64 --locked)

step "Audit dependencies"
scripts/audit

step "Test"
(cd lambda && cargo test --workspace --locked)
# Tests always use the committed fixture, never the owner's real config.
(cd cdk && SFAB_CONFIG=tests/fixtures/sfab.config.test.toml .venv/bin/python -m pytest -q)
