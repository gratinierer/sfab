#!/usr/bin/env bash
# Deploy sfab, in CodeBuild or from a machine: plans first, then runs every check, audits
# included, and stops if any fails.
#   scripts/deploy --all | <stack>...
# cdk/deploy_plan.py makes every decision: it refuses a set SFAB_CONFIG, any argument but
# --all or the app's stack names, a region other than us-east-1, and a config that doesn't
# load from the secret sfab/config. See .stories/18-deploy-from-codebuild/spec.md "A build".
set -euo pipefail
cd "$(dirname "$0")/.."

[ -d cdk/.venv ] || (cd cdk && uv venv -q .venv)
uv pip sync -q --python cdk/.venv/bin/python --require-hashes cdk/requirements.txt

# The mode for scripts/check on the first line, then the stacks, one per line.
plan_output="$(cdk/.venv/bin/python cdk/deploy_plan.py "$@")"
mapfile -t plan <<<"$plan_output"
mode="${plan[0]}"
stacks=("${plan[@]:1}")

if [ "$mode" = require-secret ]; then
  scripts/check --require-secret
else
  scripts/check
fi

cd cdk
cdk deploy --require-approval never "${stacks[@]}"
